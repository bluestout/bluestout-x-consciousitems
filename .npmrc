engine-strict=true
@shopify:registry=https://registry.npmjs.org
# Expose the GraphQL codegen CLI binary so `pnpm exec graphql-code-generator`
# works from function extension dirs (Shopify discount-function generator).
public-hoist-pattern[]=*graphql-codegen*
public-hoist-pattern[]=@graphql-codegen/*
public-hoist-pattern[]=graphql
